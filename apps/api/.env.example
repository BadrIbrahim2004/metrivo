NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Required for access-token signing. Generate a unique random value with at least 32 bytes.
AUTH_ACCESS_TOKEN_SECRET=
AUTH_ACCESS_TOKEN_ISSUER=metrivo-api
AUTH_ACCESS_TOKEN_AUDIENCE=metrivo-web

# URL-encode reserved characters in the PostgreSQL password.
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/metrivo_dev?schema=public
