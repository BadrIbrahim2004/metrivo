# Metrivo — environment variables (copy to .env and fill in; never commit real values)

# ---- API ----
# Node environment: development | test | production
NODE_ENV=development
# HTTP port for the NestJS API
PORT=3000

# PostgreSQL connection string (placeholder). For local dev compose:
DATABASE_URL=postgresql://metrivo:<password>@127.0.0.1:54329/metrivo_dev?schema=public

# ---- Optional CORS (development only) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Auth / JWT
# Minimum 32 bytes. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_ACCESS_TOKEN_SECRET=<generate-48-random-bytes>
AUTH_ACCESS_TOKEN_ISSUER=metrivo.api
AUTH_ACCESS_TOKEN_AUDIENCE=metrivo.app

# ---- Bootstrap script (apps/api/scripts/bootstrap-local-admin.ts) ----
# Local first-admin credentials; password min 12 chars. Used only for local dev.
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=<min-12-chars-password>

# ---- Notes ----
# - Never commit .env files. Use placeholders only in documentation.
# - The API validates these at startup (see apps/api/src/app.module.ts).
# - No payment-gateway credentials are required: subscriptions are managed
#   manually by the platform owner (no external billing integration exists).
