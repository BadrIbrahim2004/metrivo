# Metrivo — production environment template
# Copy to .env.production (git-ignored) and fill every value.
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

# ---- PostgreSQL ----
POSTGRES_USER=metrivo
# Strong password, min 24 chars. Never reuse the dev password.
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=metrivo_prod

# ---- API / Auth ----
# Min 32 bytes of entropy.
AUTH_ACCESS_TOKEN_SECRET=<generate-48-random-bytes>
AUTH_ACCESS_TOKEN_ISSUER=metrivo-api
AUTH_ACCESS_TOKEN_AUDIENCE=metrivo-web

# ---- Optional CORS ----
# Comma-separated list of allowed origins, e.g. https://app.example.com.
# Leave empty in production when the web app is served same-origin behind nginx.
CORS_ALLOWED_ORIGINS=
